# =============================================================
# MetaFit — Variables de entorno para Docker Compose
# Archivo: /.env  (RAÍZ del proyecto — leido por docker-compose.yml)
#
# ⚠️  IMPORTANTE: Este archivo NO debe subirse al repositorio.
#     Asegúrate de que ".env" está en tu .gitignore.
# =============================================================

# ── Servidor Backend ──────────────────────────────────────────
PORT=3001

# ── Base de Datos MySQL ───────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=MetaFit2025Dev!
DB_NAME=metafit

