# MetaFit — Variables de Entorno
# Copiar este archivo a .env y ajustar según el entorno.
# cp .env.example .env

# Puerto del backend
PORT=3001

# Base de Datos MySQL / MariaDB
# En Docker: DB_HOST=db
# Fuera de Docker: DB_HOST=localhost
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<CAMBIAR_PASSWORD_SEGURA>
DB_NAME=metafit

# JWT (generar con: openssl rand -hex 32)
JWT_SECRET=<CAMBIAR_SECRETO_ALEATORIO>
JWT_EXPIRES_IN=8h

# CORS — orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Cloudinary (fotos de perfil — almacenamiento permanente)
# Rellenar en el .env real. Si se omite, el backend cae a disco local (uploads/).
CLOUDINARY_CLOUD_NAME=<CAMBIAR_CLOUD_NAME>
CLOUDINARY_API_KEY=<CAMBIAR_API_KEY>
CLOUDINARY_API_SECRET=<CAMBIAR_API_SECRET>
