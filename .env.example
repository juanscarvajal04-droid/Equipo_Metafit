# MetaFit — Variables de Entorno
# Copiar este archivo a .env y ajustar según el entorno.
# cp .env.example .env

# Puerto del backend
PORT=3001

# ─────────────────────────────────────────────────────────────
# DESARROLLO LOCAL — apunta a Docker (docker-compose.yml)
# DB_HOST=db es el nombre del servicio 'db' dentro de la red Docker.
# NO tocar estos valores si solo levantás el entorno local.
# ─────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Admin123!
DB_NAME=metafit
DB_SSL=false

# ─────────────────────────────────────────────────────────────
# PRODUCCIÓN — cambiar estos valores en Render/VPS
# (el backend de Render usa la BD remota del VPS Oracle)
# ─────────────────────────────────────────────────────────────
# DB_HOST=141.148.94.173
# DB_PORT=3306
# DB_USER=metafit
# DB_PASSWORD=Admin123!
# DB_NAME=metafit
# DB_SSL=false

# JWT
JWT_SECRET=metafit_jwt_secret_key_2024
JWT_EXPIRES_IN=8h

# CORS — orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Cloudinary (fotos de perfil — almacenamiento permanente)
# Rellenar en el .env real. Si se omite, el backend cae a disco local (uploads/).
CLOUDINARY_CLOUD_NAME=llaq9vyl
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────
# FRONTEND WEB (Vite) — URL del backend
# docker-compose inyecta VITE_API_URL=http://localhost:3001 para LOCAL.
# En producción (Render) se inyecta la URL del backend de Render:
#   VITE_API_URL=https://metafit-backend-rr18.onrender.com
# ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
# APP MÓVIL (Expo) — URL del backend para cuando corre en navegador
# (movil/src/services/api.js usa Platform.OS === 'web')
# En el APK real (android/ios) usará siempre https://metafit-backend-rr18.onrender.com
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3001