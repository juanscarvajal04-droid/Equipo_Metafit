# MetaFit — Variables de Entorno
# Copiar este archivo a .env y ajustar según el entorno.
# cp .env.example .env

# Puerto del backend
PORT=3001

# Base de Datos MySQL
# ─────────────────────────────────────────────────────────────
# LOCAL / Docker:  DB_HOST=db  (servicio 'db' del docker-compose)
# Fuera de Docker: DB_HOST=localhost
# PRODUCCIÓN (VPS Oracle + Dokploy, BD migrada) — usá estos valores:
#   host 141.148.94.173 · puerto 3306 · user metafit · pass Admin123! · db metafit
DB_HOST=141.148.94.173
DB_PORT=3306
DB_USER=metafit
DB_PASSWORD=Admin123!
DB_NAME=metafit

# JWT
JWT_SECRET=metafit_jwt_secret_key_2024
JWT_EXPIRES_IN=8h

# CORS — orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Cloudinary (fotos de perfil — almacenamiento permanente)
# Rellenar en el .env real. Si se omite, el backend cae a disco local (uploads/).
CLOUDINARY_CLOUD_NAME=llaq9vyl
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
