# =============================================================
# MetaFit — Variables de entorno BACKEND (desarrollo local)
# Archivo: /backend/.env
# Leido por: dotenv (Node.js) en desarrollo local sin Docker
# En Docker: las variables llegan via docker-compose.yml > environment
# =============================================================

# Servidor
PORT=3001

# Entorno
NODE_ENV=development

# Base de datos MySQL — desarrollo local (sin Docker)
# En Docker DB_HOST es el nombre del servicio "db", NO localhost
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=MetaFit2025Dev!
DB_NAME=metafit

# JWT — OBLIGATORIO: reemplaza con un secreto de minimo 64 chars
# Genera uno seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# El servidor NO ARRANCARA si esta variable no esta definida.
JWT_SECRET=REEMPLAZA_ESTE_VALOR_CON_UN_SECRETO_SEGURO_DE_64_CHARS_MINIMO
JWT_EXPIRES_IN=8h

# CORS — origenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000