# MetaFit - variables de produccion (EJEMPLO, sin valores reales)
# Copiar a .env.prod y completar en el servidor. Nunca versionar .env.prod.
# chmod 600 .env.prod

# Base de datos
# MYSQL_ROOT_PASSWORD y DB_PASSWORD deben tener el mismo valor.
MYSQL_ROOT_PASSWORD=<CAMBIAR_PASSWORD_SEGURA>
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<CAMBIAR_PASSWORD_SEGURA>
DB_NAME=metafit

# Servidor
PORT=3001
NODE_ENV=production

# JWT (generar con: openssl rand -hex 32)
JWT_SECRET=<CAMBIAR_SECRETO_ALEATORIO>
JWT_EXPIRES_IN=8h

# Origenes permitidos (separados por coma)
# Incluir la URL del panel web y los origenes de desarrollo necesarios.
CORS_ORIGINS=http://<IP_PUBLICA_EC2>:5173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Correo (Brevo)
BREVO_API_KEY=<CAMBIAR_API_KEY>
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<CAMBIAR_USUARIO_SMTP>
SMTP_PASS=<CAMBIAR_PASSWORD_SMTP>
SMTP_FROM=<CORREO_REMITENTE_VERIFICADO>
FRONTEND_URL=http://<IP_PUBLICA_EC2>:5173
URL_APK=http://<IP_PUBLICA_EC2>:3001/app/metafit.apk

# Cloudinary (opcional; si se omite, usa disco local)
CLOUDINARY_CLOUD_NAME=<CAMBIAR_CLOUD_NAME>
CLOUDINARY_API_KEY=<CAMBIAR_API_KEY>
CLOUDINARY_API_SECRET=<CAMBIAR_API_SECRET>
