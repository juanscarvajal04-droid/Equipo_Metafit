    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst af = body.afiliado;\nconst now = new Date().toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    Fecha: now,\n    Nombre: af.nombre || '',\n    Correo: af.correo || '',\n    Documento: af.documento || '',\n    Objetivo: af.objetivo || '',\n    Telefono: af.telefono || '',\n    Evento: 'Nuevo Afiliado'\n  }\n}];"
      },
      "id": "code-afiliado",
      "name": "Formato Afiliado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 200]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst p = body.pago;\nconst af = body.afiliado;\nconst now = new Date().toISOString().split('T')[0];\nconst valor = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP' }).format(p.valor_pagado);\n\nreturn [{\n  json: {\n    Fecha: now,\n    Afiliado: af.nombre || '',\n    Correo: af.correo || '',\n    Valor: valor,\n    Metodo: p.metodo_pago || '',\n    Estado: p.estado || 'Pagado\",\n    Vence: p.fecha_vencimiento || '',\n    Evento: 'Pago Registrado'\n  }\n}];"
      },
      "id": "code-pago",
      "name": "Formato Pago",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 420]
    },
