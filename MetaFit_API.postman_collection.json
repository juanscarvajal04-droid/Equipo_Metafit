            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@metafit.com\",\n  \"password\": \"Maria111!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Autentica a la Recepcionista.\n\n**Permisos:** Afiliados (CRUD), Rutinas/Dietas (solo lectura). Sin acceso a Dashboard ni Gestión de Personal."
          },
          "response": []
        },
        {
          "name": "Login Entrenador (laura@metafit.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('token', jsonData.accessToken);",
                  "  pm.collectionVariables.set('token', jsonData.accessToken);",
                  "  console.log('✅ Token Entrenador guardado. Rol:', jsonData.user.role);",
                  "}"
                ]
              }
